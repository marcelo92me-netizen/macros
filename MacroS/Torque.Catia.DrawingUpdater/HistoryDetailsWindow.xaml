<Window x:Class="Torque.Catia.DrawingUpdater.HistoryDetailsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Detalhes da execução" Width="720" Height="680" MinWidth="650" MinHeight="600" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#f3f6fa" FontFamily="Segoe UI">
 <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Grid.Row="0" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Detalhes da execução" FontSize="22" FontWeight="Bold"/><TextBlock Text="{Binding FileName}" Foreground="#64748b" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}"/></StackPanel><Border Grid.Column="1" x:Name="StatusBadge" Background="#e9eef5" CornerRadius="10" Padding="12,6" VerticalAlignment="Center"><TextBlock x:Name="StatusText" Text="{Binding Status}" Foreground="#52647a" FontWeight="SemiBold"/></Border></Grid>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
   <Border Background="White" CornerRadius="10" BorderBrush="#e2e8f0" BorderThickness="1" Padding="17"><StackPanel><TextBlock Text="RESUMO" Foreground="#64748b" FontSize="11" FontWeight="Bold"/><TextBlock Text="{Binding UpdatedAt}" Margin="0,8,0,0"/><TextBlock Text="{Binding FullPath}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Border>
   <Border Background="White" CornerRadius="10" BorderBrush="#e2e8f0" BorderThickness="1" Padding="17" Margin="0,12,0,0"><StackPanel><TextBlock Text="CAMPOS ATUALIZADOS" Foreground="#166534" FontSize="11" FontWeight="Bold"/><TextBlock Text="{Binding FieldsUpdated}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>
   <Border Background="White" CornerRadius="10" BorderBrush="#e2e8f0" BorderThickness="1" Padding="17" Margin="0,12,0,0"><StackPanel><TextBlock Text="CAMPOS NÃO ATUALIZADOS / ERROS" Foreground="#92400e" FontSize="11" FontWeight="Bold"/><TextBlock Text="{Binding FieldsNotUpdated}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>
   <Border Background="White" CornerRadius="10" BorderBrush="#e2e8f0" BorderThickness="1" Padding="17" Margin="0,12,0,0"><StackPanel><TextBlock Text="RELATÓRIO DA EXECUÇÃO" Foreground="#64748b" FontSize="11" FontWeight="Bold"/><TextBlock Text="{Binding ReportPath}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>
  </StackPanel></ScrollViewer>
  <Button Grid.Row="2" Content="Fechar" IsCancel="True" HorizontalAlignment="Right" Padding="18,9" Margin="0,16,0,0"/>
 </Grid>
</Window>
