<Window x:Class="Torque.Catia.DrawingUpdater.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Torque · Atualizador de Drawings" Icon="public/favicon.ico" Width="1100" Height="850" MinWidth="900" MinHeight="700" WindowState="Maximized" WindowStartupLocation="CenterScreen" Background="#f3f6fa" FontFamily="Segoe UI">
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Background="#022d59"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Grid.Row="0" Margin="24,28,24,18"><StackPanel Orientation="Horizontal"><Border Background="White" CornerRadius="9" Padding="5" Width="48" Height="48"><Image Source="public/logo-192x192.png" Stretch="Uniform"/></Border><StackPanel VerticalAlignment="Center" Margin="12,0,0,0"><TextBlock Text="TORQUE" Foreground="White" FontSize="22" FontWeight="Bold"/><TextBlock Text="FERRAMENTAS CATIA" Foreground="#a9c2dd" FontSize="10"/></StackPanel></StackPanel>
    <Border Background="#16436e" CornerRadius="10" Padding="14" Margin="0,25,0,0"><StackPanel><TextBlock Text="01  DADOS DO PROJETO" Foreground="White" FontWeight="SemiBold"/><TextBlock Text="Escolha a pasta, revise os desenhos e atualize os carimbos." TextWrapping="Wrap" Foreground="#c5d5e6" Margin="0,8,0,0" FontSize="12"/></StackPanel></Border>
   </StackPanel>
   <StackPanel Grid.Row="1" Margin="24,8,24,12"><TextBlock Text="ARQUIVOS ATUALIZADOS" Foreground="#d9e7f4" FontSize="11" FontWeight="Bold"/><TextBlock Text="Histórico recente" Foreground="#8eaccb" FontSize="11" Margin="0,3,0,10"/><Border Background="#0b3a66" CornerRadius="9" Padding="9" MaxHeight="360"><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding UpdateHistory}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#28547b" BorderThickness="0,0,0,1" Padding="2,7"><StackPanel><TextBlock Text="{Binding FileName}" Foreground="White" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}"/><TextBlock Text="{Binding UpdatedAt}" Foreground="#9cb8d3" FontSize="10" Margin="0,3,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Border><TextBlock x:Name="HistoricoVazio" Text="Os arquivos concluídos aparecerão aqui." Foreground="#9cb8d3" FontSize="10" TextWrapping="Wrap" Margin="4,9,0,0"/></StackPanel>
   <TextBlock Grid.Row="2" Text="CATIA V5 · DRAWING" Foreground="#a9c2dd" FontSize="10" Margin="24,0,24,20"/>
  </Grid></Border>
  <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"><StackPanel Margin="34,28,34,18">
    <TextBlock Text="Atualizar informações do projeto" FontSize="25" FontWeight="Bold"/><TextBlock Text="A macro será executada dentro do CATIA para processar os desenhos." Foreground="{StaticResource Muted}" Margin="0,6,0,22"/>
    <Border Background="White" CornerRadius="12" Padding="22" BorderBrush="#e2e8f0" BorderThickness="1"><StackPanel><TextBlock Text="DADOS DO PROJETO" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Muted}" Margin="0,0,0,16"/>
     <TextBlock Text="Descrição do projeto"/><TextBox x:Name="Descricao" Margin="0,5,0,14"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Código do projeto"/><TextBox x:Name="Codigo" Margin="0,5,0,14"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Versão"/><TextBox x:Name="Versao" Margin="0,5,0,14"/></StackPanel></Grid>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Data do projeto"/><DatePicker x:Name="DataProjeto" Margin="0,5,0,14" Padding="8"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Solicitante"/><TextBox x:Name="Solicitante" Margin="0,5,0,14"/></StackPanel></Grid>
     <TextBlock Text="ART"/><TextBox x:Name="Art" Margin="0,5,0,2"/>
    </StackPanel></Border>
    <Border Background="White" CornerRadius="12" Padding="22" Margin="0,16,0,0" BorderBrush="#e2e8f0" BorderThickness="1"><StackPanel><TextBlock Text="ARQUIVOS DRAWING" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Muted}" Margin="0,0,0,12"/>
     <DockPanel><Button Content="Selecionar pasta…" Click="EscolherPasta_Click" Padding="14,8" Background="#eef4fa" BorderBrush="#d7e0ea"/><TextBlock x:Name="Pasta" Text="Nenhuma pasta selecionada" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/></DockPanel>
     <DockPanel Margin="0,14,0,8"><TextBlock x:Name="Contagem" Text="0 arquivos" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="Adicionar arquivos…" Click="AdicionarArquivos_Click" Padding="12,6" Margin="0,0,8,0"/><Button Content="Remover selecionados" Click="RemoverArquivos_Click" Padding="12,6" Margin="0,0,8,0"/><Button Content="Limpar lista" Click="LimparArquivos_Click" Padding="12,6"/></StackPanel></DockPanel>
     <ListView x:Name="ListaArquivos" Height="210" SelectionMode="Extended" BorderBrush="#d7e0ea"><ListView.View><GridView><GridViewColumn Header="Arquivo" Width="450" DisplayMemberBinding="{Binding Name}"/><GridViewColumn Header="Caminho" Width="550" DisplayMemberBinding="{Binding FullPath}"/></GridView></ListView.View></ListView>
     <TextBlock Text="A seleção será passada à macro CATScript, que abrirá e salvará os arquivos no CATIA." Foreground="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap"/>
    </StackPanel></Border>
   </StackPanel></ScrollViewer>
   <Border Grid.Row="1" Background="White" BorderBrush="#e2e8f0" BorderThickness="1,1,0,0" Padding="24,14"><DockPanel LastChildFill="False"><TextBlock x:Name="Resultado" DockPanel.Dock="Left" Text="Selecione uma pasta para carregar os drawings." VerticalAlignment="Center" Foreground="{StaticResource Muted}"/><Button x:Name="Atualizar" DockPanel.Dock="Right" Content="Executar no CATIA" Click="Atualizar_Click" Style="{StaticResource PrimaryActionButton}" HorizontalAlignment="Right"/></DockPanel></Border>
  </Grid>
 </Grid>
</Window>
