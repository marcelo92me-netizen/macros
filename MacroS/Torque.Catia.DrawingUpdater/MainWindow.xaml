<Window x:Class="Torque.Catia.DrawingUpdater.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Torque · Atualizador de Drawings" Icon="public/favicon.ico" Width="1100" Height="850" MinWidth="900" MinHeight="700" WindowState="Maximized" WindowStartupLocation="CenterScreen" Background="#f3f6fa" Foreground="#172b42" FontFamily="Segoe UI">
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Background="#022d59"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Grid.Row="0" Margin="24,28,24,18"><StackPanel Orientation="Horizontal"><Border Background="White" CornerRadius="9" Padding="5" Width="48" Height="48"><Image Source="public/logo-192x192.png" Stretch="Uniform"/></Border><StackPanel VerticalAlignment="Center" Margin="12,0,0,0"><TextBlock Text="TORQUE" Foreground="White" FontSize="22" FontWeight="Bold"/><TextBlock Text="FERRAMENTAS CATIA" Foreground="#a9c2dd" FontSize="10"/></StackPanel></StackPanel>
    <Border Background="#16436e" CornerRadius="10" Padding="14" Margin="0,25,0,0"><StackPanel><TextBlock Text="01  DADOS DO PROJETO" Foreground="White" FontWeight="SemiBold"/><TextBlock Text="Escolha a pasta, revise os desenhos e atualize os carimbos." TextWrapping="Wrap" Foreground="#c5d5e6" Margin="0,8,0,0" FontSize="12"/></StackPanel></Border>
   </StackPanel>
   <Grid Grid.Row="1" Margin="24,8,24,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Grid.Row="0" Text="HISTÓRICO DE EXECUÇÕES" Foreground="#d9e7f4" FontSize="11" FontWeight="Bold"/><TextBlock Grid.Row="1" Text="Clique em um arquivo para ver os detalhes" Foreground="#8eaccb" FontSize="10" Margin="0,3,0,10"/><Border Grid.Row="2" Background="#0b3a66" CornerRadius="9" Padding="7"><ListBox x:Name="HistoricoLista" ItemsSource="{Binding UpdateHistory}" SelectionChanged="HistoricoLista_SelectionChanged" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="2"/><Setter Property="Margin" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="#28547b"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ItemBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="5,9"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#16436e"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#20527d"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding FileName}" Foreground="White" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}"/><TextBlock Text="{Binding UpdatedAt}" Foreground="#9cb8d3" FontSize="10" Margin="0,3,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="#d9e7f4" FontSize="9" VerticalAlignment="Center" Margin="7,0,0,0"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Border><TextBlock x:Name="HistoricoVazio" Grid.Row="3" Text="Os arquivos processados aparecerão aqui." Foreground="#9cb8d3" FontSize="10" TextWrapping="Wrap" Margin="4,9,0,0"/></Grid>
   <TextBlock Grid.Row="2" Text="CATIA V5 · DRAWING" Foreground="#a9c2dd" FontSize="10" Margin="24,0,24,20"/>
  </Grid></Border>
  <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"><StackPanel Margin="34,28,34,18">
    <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Atualizar informações do projeto" FontSize="25" FontWeight="Bold"/><TextBlock Text="A macro será executada dentro do CATIA para processar os desenhos." Foreground="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel><Button Grid.Column="1" Click="ConfigurarCampos_Click" ToolTip="Configurar nomes dos campos de texto do CATIA" AutomationProperties.Name="Configurações dos campos CATIA" Width="42" Height="42" Margin="16,0,0,0" Background="White" BorderBrush="#d7e0ea" BorderThickness="1" Cursor="Hand"><TextBlock Text="&#x2699;" FontFamily="Segoe UI Symbol" FontSize="23" Foreground="#022d59" HorizontalAlignment="Center" VerticalAlignment="Center"/></Button></Grid>
    <Border Background="White" CornerRadius="12" Padding="22" BorderBrush="#e2e8f0" BorderThickness="1"><StackPanel><TextBlock Text="DADOS DO PROJETO" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Muted}" Margin="0,0,0,16"/>
     <TextBlock Text="Descrição do projeto"/><Grid Margin="0,5,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="Descricao" TextChanged="Campo_TextChanged"/><Border x:Name="BadgeDescricao" Grid.Column="1" Style="{StaticResource FieldBadge}" Margin="10,0,0,0"><TextBlock x:Name="BadgeDescricaoTexto" Text="Ignorado"/></Border></Grid>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Código do projeto"/><Grid Margin="0,5,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="Codigo" TextChanged="Campo_TextChanged"/><Border x:Name="BadgeCodigo" Grid.Column="1" Style="{StaticResource FieldBadge}" Margin="8,0,0,0"><TextBlock x:Name="BadgeCodigoTexto" Text="Ignorado"/></Border></Grid></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Versão"/><Grid Margin="0,5,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="Versao" TextChanged="Campo_TextChanged"/><Border x:Name="BadgeVersao" Grid.Column="1" Style="{StaticResource FieldBadge}" Margin="8,0,0,0"><TextBlock x:Name="BadgeVersaoTexto" Text="Ignorado"/></Border></Grid></StackPanel></Grid>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Data do projeto"/><Grid Margin="0,5,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><DatePicker x:Name="DataProjeto" SelectedDateChanged="DataProjeto_SelectedDateChanged" Padding="8"/><Border x:Name="BadgeData" Grid.Column="1" Style="{StaticResource FieldBadge}" Margin="8,0,0,0"><TextBlock x:Name="BadgeDataTexto" Text="Ignorado"/></Border></Grid></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Solicitante"/><Grid Margin="0,5,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="Solicitante" TextChanged="Campo_TextChanged"/><Border x:Name="BadgeSolicitante" Grid.Column="1" Style="{StaticResource FieldBadge}" Margin="8,0,0,0"><TextBlock x:Name="BadgeSolicitanteTexto" Text="Ignorado"/></Border></Grid></StackPanel></Grid>
     <TextBlock Text="ART"/><Grid Margin="0,5,0,2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="Art" TextChanged="Campo_TextChanged"/><Border x:Name="BadgeArt" Grid.Column="1" Style="{StaticResource FieldBadge}" Margin="10,0,0,0"><TextBlock x:Name="BadgeArtTexto" Text="Ignorado"/></Border></Grid>
    </StackPanel></Border>
    <Border Background="White" CornerRadius="12" Padding="22" Margin="0,16,0,0" BorderBrush="#e2e8f0" BorderThickness="1"><StackPanel><TextBlock Text="ARQUIVOS DRAWING" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Muted}" Margin="0,0,0,12"/>
     <DockPanel><Button Content="Selecionar pasta…" Click="EscolherPasta_Click" Padding="14,8" Background="#eef4fa" BorderBrush="#d7e0ea"/><TextBlock x:Name="Pasta" Text="Nenhuma pasta selecionada" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/></DockPanel>
     <DockPanel Margin="0,14,0,8"><TextBlock x:Name="Contagem" Text="0 arquivos" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="Adicionar arquivos…" Click="AdicionarArquivos_Click" Padding="12,6" Margin="0,0,8,0"/><Button Content="Remover selecionados" Click="RemoverArquivos_Click" Padding="12,6" Margin="0,0,8,0"/><Button Content="Limpar lista" Click="LimparArquivos_Click" Padding="12,6"/></StackPanel></DockPanel>
     <ListView x:Name="ListaArquivos" Height="260" SelectionMode="Extended" BorderBrush="#d7e0ea"><ListView.View><GridView>
      <GridViewColumn Header="Arquivo" Width="250" DisplayMemberBinding="{Binding Name}"/>
      <GridViewColumn Header="Caminho" Width="390" DisplayMemberBinding="{Binding FullPath}"/>
      <GridViewColumn Header="Status da execução" Width="145"><GridViewColumn.CellTemplate><DataTemplate><Border x:Name="StatusBadge" Background="#e9eef5" CornerRadius="9" Padding="8,3" HorizontalAlignment="Left"><TextBlock x:Name="StatusText" Text="{Binding Status}" Foreground="#52647a" FontSize="11" FontWeight="SemiBold"/></Border><DataTemplate.Triggers>
       <DataTrigger Binding="{Binding Status}" Value="Sucesso"><Setter TargetName="StatusBadge" Property="Background" Value="#dcfce7"/><Setter TargetName="StatusText" Property="Foreground" Value="#166534"/></DataTrigger>
       <DataTrigger Binding="{Binding Status}" Value="Atenção"><Setter TargetName="StatusBadge" Property="Background" Value="#fef3c7"/><Setter TargetName="StatusText" Property="Foreground" Value="#92400e"/></DataTrigger>
       <DataTrigger Binding="{Binding Status}" Value="Erro"><Setter TargetName="StatusBadge" Property="Background" Value="#fee2e2"/><Setter TargetName="StatusText" Property="Foreground" Value="#991b1b"/></DataTrigger>
      </DataTemplate.Triggers></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
      <GridViewColumn Header="Detalhes das alterações" Width="480"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Details}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Details}" VerticalAlignment="Center"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
     </GridView></ListView.View></ListView>
     <TextBlock Text="A seleção será passada à macro CATScript, que abrirá e salvará os arquivos no CATIA." Foreground="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap"/>
    </StackPanel></Border>
   </StackPanel></ScrollViewer>
   <Border Grid.Row="1" Background="White" BorderBrush="#e2e8f0" BorderThickness="1,1,0,0" Padding="24,14"><DockPanel LastChildFill="False"><TextBlock x:Name="Resultado" DockPanel.Dock="Left" Text="Selecione uma pasta para carregar os drawings." VerticalAlignment="Center" Foreground="{StaticResource Muted}"/><Button x:Name="Atualizar" DockPanel.Dock="Right" Content="Executar no CATIA" Click="Atualizar_Click" Style="{StaticResource PrimaryActionButton}" HorizontalAlignment="Right"/></DockPanel></Border>
  </Grid>
 </Grid>
</Window>
