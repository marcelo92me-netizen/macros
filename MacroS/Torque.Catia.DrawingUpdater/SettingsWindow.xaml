<Window x:Class="Torque.Catia.DrawingUpdater.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Perfis de configuração CATIA" Width="780" Height="690" MinWidth="720" MinHeight="620" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#f3f6fa" FontFamily="Segoe UI">
 <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Grid.Row="0" Margin="0,0,0,18"><TextBlock Text="Perfis de configuração" FontSize="23" FontWeight="Bold"/><TextBlock Text="Escolha o perfil de Feature Names usado para localizar os campos nos Drawings." Foreground="#64748b" Margin="0,5,0,0"/></StackPanel>
  <Border Grid.Row="1" Background="White" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="10" Padding="16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Perfil ativo" VerticalAlignment="Center" Margin="0,0,14,0"/><ComboBox x:Name="ProfileSelector" Grid.Column="1" Padding="9" SelectionChanged="ProfileSelector_SelectionChanged"/></Grid></Border>
  <Grid Grid.Row="2" Margin="0,12,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock x:Name="ProfileHint" Grid.Row="0" Grid.ColumnSpan="4" Text="O perfil padrão usa os nomes definidos pela ferramenta." VerticalAlignment="Center" Foreground="#64748b" FontSize="12" Margin="0,0,0,9"/><TextBlock Grid.Row="1" Text="Novo perfil" VerticalAlignment="Center" Margin="0,0,9,0" Foreground="#334155"/><TextBox x:Name="NewProfileName" Grid.Row="1" Grid.Column="1" MinWidth="160" IsTabStop="True" FontSize="14" Padding="11,9" VerticalContentAlignment="Center" Foreground="#172b42" Background="White" CaretBrush="#022d59" SelectionBrush="#9cc5ec" BorderBrush="#b8c7d8"/><Button x:Name="ExcluirPerfilButton" Grid.Row="1" Grid.Column="2" Content="Excluir perfil" Click="ExcluirPerfil_Click" Padding="12,7" Margin="8,0,0,0"/><Button Grid.Row="1" Grid.Column="3" Content="Criar perfil" Click="CriarPerfil_Click" Padding="12,7" Margin="8,0,0,0"/></Grid>
  <Border Grid.Row="3" Background="White" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="10" Padding="18"><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Grid.Row="0" Grid.Column="0"><TextBlock Text="Descrição do projeto"/><TextBox x:Name="CampoDesc" Margin="0,5,0,16"/></StackPanel>
   <StackPanel Grid.Row="0" Grid.Column="2"><TextBlock Text="Código do projeto"/><TextBox x:Name="CampoCodigo" Margin="0,5,0,16"/></StackPanel>
   <StackPanel Grid.Row="0" Grid.Column="4"><TextBlock Text="Versão do projeto"/><TextBox x:Name="CampoVersao" Margin="0,5,0,16"/></StackPanel>
   <StackPanel Grid.Row="1" Grid.Column="0"><TextBlock Text="Data do projeto"/><TextBox x:Name="CampoData" Margin="0,5,0,16"/></StackPanel>
   <StackPanel Grid.Row="1" Grid.Column="2"><TextBlock Text="Solicitante"/><TextBox x:Name="CampoSolicitante" Margin="0,5,0,16"/></StackPanel>
   <StackPanel Grid.Row="1" Grid.Column="4"><TextBlock Text="ART"/><TextBox x:Name="CampoArt" Margin="0,5,0,16"/></StackPanel>
   <StackPanel Grid.Row="2" Grid.Column="0"><TextBlock Text="Versão da ART"/><TextBox x:Name="CampoVersaoArt" Margin="0,5,0,0"/></StackPanel>
   <StackPanel Grid.Row="2" Grid.Column="2"><TextBlock Text="Data da ART"/><TextBox x:Name="CampoDataArt" Margin="0,5,0,0"/></StackPanel>
   <StackPanel Grid.Row="2" Grid.Column="4"><TextBlock Text="Empresa da ART"/><TextBox x:Name="CampoEmpresaArt" Margin="0,5,0,0"/></StackPanel>
  </Grid></ScrollViewer></Border>
  <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Content="Cancelar" IsCancel="True" Padding="18,9" Margin="0,0,10,0"/><Button Content="Salvar e usar perfil" IsDefault="True" Click="Salvar_Click" Background="#022d59" Foreground="White" FontWeight="SemiBold" Padding="18,9" BorderThickness="0"/></StackPanel>
 </Grid>
</Window>
